// Matches docs/proposal.md, amended 2026-09-10 per CLAUDE.md §5: the peer-to-classmate
// API integration (Merch/HelpDesk) was replaced with a genuine public API (Discord
// webhook) for the consume side; the exposed endpoint stays but isn't team-specific.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // injected at runtime from Key Vault
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum PreorderStatus {
  PENDING // not sent yet: waiting to be published, or still being retried
  CONFIRMED
  FAILED // gave up — publishing the event again queues a fresh attempt
}

enum OutboxStatus {
  PENDING // due at runAt: a first try, or a retry after a failure
  PROCESSING // claimed by a worker until lockedUntil
  DONE
  DEAD // gave up: an error retrying can't fix, or out of attempts
}

model User {
  id          Int      @id @default(autoincrement())
  adObjectId  String   @unique @map("ad_object_id") // Entra 'oid' claim
  email       String   @unique
  displayName String   @map("display_name")
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now()) @map("created_at")

  eventsOrganized Event[]    @relation("Organizer")
  bookings        Booking[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Venue {
  id           Int     @id @default(autoincrement())
  name         String
  roomNumber   String? @map("room_number") // e.g. "402" - used by the exposed room-status lookup
  addressRaw   String  @map("address_raw")
  latitude     Float? // set from the pin dropped on the map when the venue is created
  longitude    Float?
  isVerified   Boolean @default(false) @map("is_verified")
  isArchived   Boolean @default(false) @map("is_archived") // hidden from new events; kept on old ones

  events Event[]

  @@map("venues")
}

model Event {
  id                Int         @id @default(autoincrement())
  organizerId       Int         @map("organizer_id")
  venueId           Int         @map("venue_id")
  title             String
  description       String?     @db.Text
  capacity          Int
  startsAt          DateTime    @map("starts_at")
  endsAt            DateTime    @map("ends_at")
  isLargeConference Boolean     @default(false) @map("is_large_conference") // true when the organizer attached a supply order
  status            EventStatus @default(DRAFT)
  createdAt         DateTime    @default(now()) @map("created_at")

  organizer User           @relation("Organizer", fields: [organizerId], references: [id])
  venue     Venue          @relation(fields: [venueId], references: [id])
  bookings  Booking[]
  preorder  MerchPreorder?
  image     EventImage?

  @@index([venueId])
  @@index([organizerId])
  @@map("events")
}

model Booking {
  id        Int           @id @default(autoincrement())
  eventId   Int           @map("event_id")
  studentId Int           @map("student_id")
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now()) @map("created_at")

  event   Event @relation(fields: [eventId], references: [id])
  student User  @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId]) // one booking per student per event
  @@map("bookings")
}

// A supply order an organizer attaches to an event ("200 x Blank lanyards"). Kept the
// model name from docs/proposal.md; the fulfilment channel is now a Discord webhook
// rather than the Merch team's API (CLAUDE.md §5), and the item/quantity are chosen by
// the organizer rather than a fixed 50 lanyards (2026-09-16).
model MerchPreorder {
  id           Int            @id @default(autoincrement())
  eventId      Int            @unique @map("event_id") // 1:0..1 with Event
  item         String         @default("Blank lanyards")
  quantity     Int
  peerOrderRef String?        @map("peer_order_ref") // Discord message id from the webhook post
  status       PreorderStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@map("merch_preorders")
}

// The poster an organizer uploads for an event. Its own table so listing events never
// drags image bytes along, and stored in the database rather than on the VM's disk so a
// redeploy, a container rebuild and a DB restore all keep the images. The browser
// downscales before uploading, so rows are a few hundred KB.
model EventImage {
  eventId   Int      @id @map("event_id")
  // Random, and regenerated on every upload: the URL is unguessable (so a draft's poster
  // isn't public) and changes when the image does (so caches can't serve a stale one).
  key       String   @unique
  mimeType  String   @map("mime_type")
  bytes     Bytes    @db.LongBlob
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_images")
}

// Work that has to happen after a database change and must not be lost — today, posting a
// supply order to Discord. A job is written in the same transaction as the change that
// needs it, so it exists exactly when that change does, and survives restarts. A worker in
// the app process delivers it and retries with backoff (services/outbox.js).
model OutboxJob {
  id          Int          @id @default(autoincrement())
  type        String // which handler runs it, e.g. "supply.send"
  payload     Json
  dedupeKey   String?      @map("dedupe_key") // at most one live job per key, e.g. "supply:12"
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(8) @map("max_attempts")
  runAt       DateTime     @default(now()) @map("run_at")
  lockToken   String?      @map("lock_token") // which claim owns it while PROCESSING
  lockedUntil DateTime?    @map("locked_until")
  lastError   String?      @map("last_error") @db.Text
  note        String?      @db.Text // what happened, e.g. "sent: Discord message 1549…"
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  completedAt DateTime?    @map("completed_at")

  @@index([status, runAt])
  @@index([dedupeKey])
  @@map("outbox_jobs")
}

// Who did what, kept for the Admin activity view and each event's history.
// Student bookings are deliberately not logged — they'd bury the organizer/admin actions
// this is for, and a booking's own row already records who booked and when.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id") // null if the account is later removed
  actorLabel String   @map("actor_label") // name/email as it was at the time
  action     String // e.g. "event.cancelled", "user.role_changed"
  entityType String   @map("entity_type") // "event" | "venue" | "user" | "apiKey"
  entityId   Int?     @map("entity_id")
  summary    String   @db.Text // one human-readable sentence
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiKey {
  id         Int      @id @default(autoincrement())
  ownerLabel String   @map("owner_label") // free-text label for whoever the key was issued to
  keyHash    String   @map("key_hash") // store hash, never the raw key
  scope      String // e.g. "room-status:read"
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}
