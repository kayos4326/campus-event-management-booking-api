# Non-secret bootstrap config only — actual secrets are fetched from Key Vault
# at runtime (see CLAUDE.md §4 and src/config/keyvault.js).

PORT=3001

# Entra ID (AD) tenant this app is registered in — Assumption University's tenant
# (real target users are AU students/organizers, not KMUTT — see CLAUDE.md §4)
TENANT_ID=c1f3dc23-b7f8-48d3-9b5d-2b12f158f01f
CLIENT_ID=f581260c-6bc3-4f8c-a711-ac2ca274f56b

# Key Vault this app's managed identity reads from
KEY_VAULT_URL=https://campus-event-api-kv.vault.azure.net/
